# ---- Backend (Render): set as an Environment Variable in the Render dashboard ----
# Comma-separated list of allowed frontend origins. In production set this to
# your Vercel URL, e.g. https://stock-trading-assistant.vercel.app
# Keep the default for local dev.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Simple API key to protect endpoints. Leave empty to disable auth (local dev only).
BACKEND_API_KEY=your_backend_api_key_here

# ---- Groww Trading API ----
# Option A: Provide API key + secret (backend will exchange for an access token).
# Get your API key and secret from https://groww.in/trade-api/api-keys
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# Option B: If you already have a Groww access token/JWT, set it here directly.
# If this is set, GROWW_API_KEY/GROWW_API_SECRET are not required.
GROWW_ACCESS_TOKEN=your_groww_access_token_here

# Optional: set to "true" to allow real order placement (default: false/safe mode)
GROWW_ALLOW_REAL_ORDERS=false

# ---- Autonomous trading loop (backend/autonomous/trader.py) ----
# Run with: python -m backend.autonomous.trader
# Comma-separated tickers WITHOUT the .NS suffix (Groww format), e.g. RELIANCE,TCS,INFY
AUTOTRADE_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
AUTOTRADE_EXCHANGE=NSE

# How often to poll live price (seconds) and re-run the full analysis pipeline (seconds).
AUTOTRADE_TICK_SECONDS=1
AUTOTRADE_PIPELINE_REFRESH_SECONDS=60
AUTOTRADE_CANDLE_INTERVAL=5m
AUTOTRADE_CANDLE_PERIOD=60d

# Decision thresholds (0-1). Higher = more conservative / fewer trades.
AUTOTRADE_BUY_THRESHOLD=0.68
AUTOTRADE_SELL_THRESHOLD=0.65

# ---- Risk guardrails (all enforced regardless of strategy signals) ----
# Max % of available margin per trade, and an absolute rupee ceiling on top.
AUTOTRADE_MAX_CAPITAL_PCT=0.05
AUTOTRADE_MAX_CAPITAL_ABS=10000
# Stop opening new positions once today's realized+unrealized loss exceeds
# this % of the day's starting margin. Reset via POST /autonomous/kill-switch/reset.
AUTOTRADE_DAILY_LOSS_LIMIT_PCT=0.03
AUTOTRADE_MAX_OPEN_POSITIONS=3
AUTOTRADE_COOLDOWN_MINUTES=15
# How often (seconds) to log a plain price/probability "observe" event per
# ticker for the frontend dashboard, independent of actual trades.
AUTOTRADE_OBSERVE_LOG_SECONDS=10

# Starting paper bankroll used for position sizing when GROWW_ALLOW_REAL_ORDERS
# is false and no real Groww credentials are configured.
AUTOTRADE_PAPER_CAPITAL=100000

# ---- Frontend (Vercel): set as a Build Environment Variable in the Vercel dashboard ----
# The deployed backend URL, e.g. https://stock-trading-assistant.onrender.com
# Vite inlines this at build time, so it must be set BEFORE the build runs.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: if BACKEND_API_KEY is set on the backend, set the same value here
# so the frontend sends it automatically.
VITE_BACKEND_API_KEY=your_backend_api_key_here
