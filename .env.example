# ---- Backend (Render): set as an Environment Variable in the Render dashboard ----
# Comma-separated list of allowed frontend origins. In production set this to
# your Vercel URL, e.g. https://stock-trading-assistant.vercel.app
# Keep the default for local dev.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Simple API key to protect endpoints. Leave empty to disable auth (local dev only).
BACKEND_API_KEY=your_backend_api_key_here

# ---- Groww Trading API ----
# Option A: Provide API key + secret (backend will exchange for an access token).
# Get your API key and secret from https://groww.in/trade-api/api-keys
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# Option B: If you already have a Groww access token/JWT, set it here directly.
# If this is set, GROWW_API_KEY/GROWW_API_SECRET are not required.
GROWW_ACCESS_TOKEN=your_groww_access_token_here

# Optional: set to "true" to allow real order placement (default: false/safe mode)
GROWW_ALLOW_REAL_ORDERS=false

# ---- Frontend (Vercel): set as a Build Environment Variable in the Vercel dashboard ----
# The deployed backend URL, e.g. https://stock-trading-assistant.onrender.com
# Vite inlines this at build time, so it must be set BEFORE the build runs.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: if BACKEND_API_KEY is set on the backend, set the same value here
# so the frontend sends it automatically.
VITE_BACKEND_API_KEY=your_backend_api_key_here
